# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Twitch API for streamer data
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_STREAM_PAGE_LIMIT=35

# GitHub API - for changelog (optional)
GITHUB_REPO_OWNER=repository-owner
GITHUB_REPO_NAME=repository-name
GITHUB_TOKEN=your-github-token

# GitHub API - for feedback form
GITHUB_ACCESS_TOKEN=your-github-personal-access-token
GITHUB_OWNER=your-github-username
GITHUB_REPO=GTARP.PlayerCountTracker

# Security Settings
NODE_ENV=production
ADMIN_TOKEN=your-secure-admin-token-here 

# Grok AI API Configuration
GROK_API_KEY=your-grok-api-key
GROK_API_BASE_URL=https://api.xai.com/v1
GROK_MODEL=grok-1

# Web Push / VAPID (User Alerts & Notifications - R3.4)
# Generate a key pair once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a 'mailto:' address or an https URL identifying the sender.
VAPID_SUBJECT=mailto:admin@rpstats.com
# Server-only private key. NEVER expose this to the client.
VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID public key. NON-SECRET. VAPID_PUBLIC_KEY (server) and
# NEXT_PUBLIC_VAPID_PUBLIC_KEY (client, used to subscribe in the browser) must
# hold the SAME public key value.
VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
