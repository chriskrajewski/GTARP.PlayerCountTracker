# This file adds health check endpoints to the main nginx server block
# The location blocks will be included in EB's main server configuration

files:
  "/etc/nginx/conf.d/health.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Health check endpoints
      # These location blocks are included in the main server block by EB
      
      # Health check - proxy to app so ALB sees real app health
      location = /health {
        proxy_pass http://localhost:3000/api/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        access_log off;
      }

      # Application health check - proxied to Next.js (detailed info)
      # Requires Next.js app to be running
      location = /api/health {
        proxy_pass http://localhost:3000/api/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        access_log off;
      }

container_commands:
  01_reload_nginx:
    command: "service nginx reload || true"
