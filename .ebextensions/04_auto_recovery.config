option_settings:
  # Enhanced Health Reporting - Required for auto-recovery
  # Use /health (nginx-served, faster) for basic checks
  # Use /api/health (Next.js) for detailed application health
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
    HealthCheckSuccessThreshold: Ok
    HealthCheckURL: /health
  
  # Health Check Configuration
  # Primary: /health (nginx, fast, always available)
  # Secondary: /api/health (Next.js, detailed health info)
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
  
  # Auto Scaling Configuration - Replace Unhealthy Instances
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 4
    Cooldown: 360
  
  # Load Balancer Health Check Settings
  aws:elb:healthcheck:
    HealthyThreshold: 3
    Interval: 30
    Timeout: 5
    UnhealthyThreshold: 5
  
  # Rolling Updates - Replace instances during updates
  aws:elasticbeanstalk:command:
    BatchSize: 1
    BatchSizeType: Percentage
    Timeout: 600
