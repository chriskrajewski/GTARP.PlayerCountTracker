option_settings:
  # Enhanced Health Reporting - Required for auto-recovery
  # Using /api/health (Next.js route) for health checks
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
    HealthCheckSuccessThreshold: Ok
  
  # Health Check Configuration
  # For Application Load Balancer (ALB) - using /api/health endpoint
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
  
  # Auto Scaling Configuration - Replace Unhealthy Instances
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 4
    Cooldown: 360
    HealthCheckType: ELB
    HealthCheckGracePeriod: 120
  
  # Load Balancer (ALB) Health Check Settings
  aws:elbv2:targetgroup:
    HealthyThresholdCount: 2
    UnhealthyThresholdCount: 1
    HealthCheckIntervalSeconds: 15
    HealthCheckTimeoutSeconds: 5
  
  # Rolling Updates - Replace instances during updates
  aws:elasticbeanstalk:command:
    BatchSize: 1
    BatchSizeType: Percentage
    Timeout: 600
