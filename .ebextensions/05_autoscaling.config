option_settings:
  # Auto Scaling Triggers - Scale based on CPU
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    LowerThreshold: 20
    UpperThreshold: 80
    ScaleUpIncrement: 1
    ScaleDownIncrement: -1
    BreachDuration: 5
    Period: 5
    EvaluationPeriods: 1
  
  # Additional trigger for NetworkOut (traffic-based scaling)
  aws:autoscaling:trigger:
    MeasureName: NetworkOut
    Statistic: Average
    Unit: Bytes
    LowerThreshold: 1000000
    UpperThreshold: 50000000
    ScaleUpIncrement: 1
    ScaleDownIncrement: -1
    BreachDuration: 5
    Period: 5
    EvaluationPeriods: 1
  
  # Instance Limits
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 4
    Cooldown: 360
  
  # Enable automatic instance replacement
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
