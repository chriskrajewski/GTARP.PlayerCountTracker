option_settings:
  # Auto Scaling Triggers - Scale based on CPU
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    LowerThreshold: 20
    UpperThreshold: 80
    UpperBreachScaleIncrement: 1
    LowerBreachScaleIncrement: -1
    BreachDuration: 5
    Period: 5
    EvaluationPeriods: 1
  
  # Instance Limits
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 4
    Cooldown: 360
