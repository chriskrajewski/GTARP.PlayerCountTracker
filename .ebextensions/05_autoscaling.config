option_settings:
  # Auto Scaling Triggers
  # Note: EB only supports one trigger via config. For memory-based scaling,
  # you'll need to set up a CloudWatch alarm separately or use the console.
  # Keeping CPU-based here as a baseline.
  aws:autoscaling:trigger:
    MeasureName: CPUUtilization
    Statistic: Average
    Unit: Percent
    LowerThreshold: 20
    UpperThreshold: 70
    UpperBreachScaleIncrement: 1
    LowerBreachScaleIncrement: -1
    BreachDuration: 3
    Period: 1
    EvaluationPeriods: 3
  
  # Instance Limits
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 4
    Cooldown: 180
