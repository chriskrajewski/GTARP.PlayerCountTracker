files:
  "/opt/elasticbeanstalk/tasks/taillogs.d/01-app-logs.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/web.stdout.log
      /var/log/nginx/error.log
      /var/log/nginx/access.log

container_commands:
  01_install_htop:
    command: "yum install -y htop || apt-get install -y htop || true"
  02_setup_log_rotation:
    command: |
      cat > /etc/logrotate.d/eb-app << 'EOF'
      /var/log/web.stdout.log {
        daily
        missingok
        rotate 7
        compress
        notifempty
        create 644 webapp webapp
        postrotate
          /bin/kill -USR1 $(cat /var/run/nginx.pid 2>/dev/null) 2>/dev/null || true
        endscript
      }
      EOF

option_settings:
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 14
  aws:elasticbeanstalk:cloudwatch:logs:health:
    HealthStreamingEnabled: true
    DeleteOnTerminate: false
    RetentionInDays: 7